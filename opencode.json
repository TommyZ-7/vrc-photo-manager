{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    {
      "action": "shell",
      "resource": "git checkout *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git checkout main *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git checkout main",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git checkout -- *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git switch *",
      "effect": "deny"
    },
    {
      "action": "shell",
      "resource": "git switch main *",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git switch main",
      "effect": "allow"
    },
    {
      "action": "shell",
      "resource": "git worktree *",
      "effect": "allow"
    }
  ]
}
